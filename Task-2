import java.util.Scanner;

public class Task2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();

        int max = arr[0], min = arr[0];
        int maxIndex = 0, minIndex = 0;

        // 1 & 2. Find largest and smallest
        for (int i = 1; i < 10; i++) {
            if (arr[i] > max) {
                max = arr[i];
                maxIndex = i; // save index of max
            }
            if (arr[i] < min) {
                min = arr[i];
                minIndex = i; // save index of min
            }
        }

        // 3. Find second minimum
        int secondMin = Integer.MAX_VALUE;
        for (int i = 0; i < 10; i++) {
            // number should be greater than min and smaller than current secondMin
            if (arr[i] > min && arr[i] < secondMin) {
                secondMin = arr[i];
            }
        }

        // 4. Display values with indices
        System.out.println("Largest element: " + max + " at index " + maxIndex);
        System.out.println("Smallest element: " + min + " at index " + minIndex);
        System.out.println("Second minimum value: " + secondMin);
        sc.close();
    }
}