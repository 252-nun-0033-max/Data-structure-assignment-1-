import java.util.Scanner;

public class Task4 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();

        System.out.print("Enter number to search: ");
        int searchNum = sc.nextInt();

        boolean found = false;
        System.out.print("Number found at indices: ");
        // 1 & 2. Linear search and display all indices
        for (int i = 0; i < 10; i++) {
            if (arr[i] == searchNum) {
                System.out.print(i + " ");
                found = true;
            }
        }

        // 3. Message if not found
        if (!found) {
            System.out.println("\nNumber not found in array!");
        }
        sc.close();
    }
}