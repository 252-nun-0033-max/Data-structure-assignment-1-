import java.util.Scanner;

public class Task8 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();

        // 1. Sort in ascending order using Bubble Sort
        for (int i = 0; i < 9; i++) {
            for (int j = 0; j < 9 - i; j++) {
                if (arr[j] > arr[j + 1]) {
                    // swap
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }

        // 2. Display sorted array
        System.out.println("Sorted array (Ascending):");
        for (int n : arr) System.out.print(n + " ");

        // 3. Display in descending order
        System.out.println("\nSorted array (Descending):");
        for (int i = 9; i >= 0; i--) {
            System.out.print(arr[i] + " ");
        }
        sc.close();
    }
}