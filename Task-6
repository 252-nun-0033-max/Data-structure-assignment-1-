import java.util.Scanner;

public class Task6 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        System.out.println("Enter 10 integers:");
        for (int i = 0; i < 10; i++) arr[i] = sc.nextInt();

        // 1. Ask for index to delete
        System.out.print("Enter index to delete (0-9): ");
        int index = sc.nextInt();

        // 2 & 3. Delete and shift remaining elements to left
        for (int i = index; i < 9; i++) {
            arr[i] = arr[i + 1]; // shifting left to fill the gap
        }

        // 4. Display updated array (now size will be 9)
        System.out.println("Updated array after deletion:");
        for (int i = 0; i < 9; i++) {
            System.out.print(arr[i] + " ");
        }
        sc.close();
    }
}